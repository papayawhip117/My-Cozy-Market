# Copy this file to .env and fill in the two values from your Supabase
# project (Project Settings -> API). .env is in .gitignore, so your real
# values never go to GitHub. On Vercel, add the same two names under
# Project Settings -> Environment Variables.
#
# Leave them empty to play in offline guest mode (no login).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
